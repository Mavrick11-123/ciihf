---
import Layout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import sponsors from '../content/sponsors.json';
import { base } from '../lib/base';

const helmetTier = sponsors.tiers.find((t) => t.id === 'helmet');
const jerseyTier = sponsors.tiers.find((t) => t.id === 'jersey');
---

<Layout
  title="Sponsors"
  description="Partner with the Cayman Islands Inline Hockey Federation — youth development, national teams, and travel."
>
  <PageHero
    eyebrow="Sponsors"
    title="Support Cayman hockey"
    lead="Sponsorship fuels youth development, travel teams, and community leagues at King's Sports Centre."
  />

  <section id="list" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-14 md:px-6">
    <h2 class="text-4xl text-navy">Sponsor list</h2>
    <p class="mt-3 max-w-2xl text-ink/75">{sponsors.currentNote}</p>

    {
      helmetTier && (
        <div class="mt-10">
          <p class="text-sm font-semibold tracking-[0.2em] text-red uppercase">{helmetTier.label}</p>
          <div class="mt-4 grid gap-4 md:grid-cols-2 md:items-stretch">
            <div class="flex min-h-48 flex-col items-center justify-center gap-2 border border-sand bg-white p-8 shadow-sm">
              <p class="font-display text-4xl text-navy md:text-5xl">Tim Hortons</p>
              <p class="text-xs font-semibold tracking-wide text-red uppercase">Helmet sponsor</p>
            </div>
            <figure class="flex items-center justify-center overflow-hidden border border-sand bg-navy/95 p-4 shadow-sm">
              <img
                src={`${base}images/sponsors/tim-hortons-helmet.jpg`}
                alt="Red CCM hockey helmet with Tim Hortons maple leaf sticker"
                class="max-h-64 w-auto max-w-full object-contain md:max-h-72"
                width="874"
                height="1024"
              />
            </figure>
          </div>
        </div>
      )
    }

    {
      jerseyTier && (
        <div class="mt-12">
          <p class="text-sm font-semibold tracking-[0.2em] text-red uppercase">{jerseyTier.label}</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
            {jerseyTier.sponsors.map((s) => (
              <div class="flex min-h-28 flex-col items-center justify-center gap-2 border border-sand bg-white p-6 shadow-sm">
                <p class="font-display text-3xl text-navy">{s.name}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-14">
      <h3 class="font-display text-2xl text-navy">Historical partners (archive)</h3>
      <p class="mt-2 max-w-3xl text-sm text-ink/60">{sponsors.historicalNote}</p>
      <p class="mt-4 text-sm leading-relaxed text-ink/70">{sponsors.historical.join(' · ')}</p>
    </div>
  </section>

  <section id="welcome" class="scroll-mt-24 bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
      <h2 class="text-4xl">New sponsors welcome</h2>
      <p class="mt-4 max-w-2xl text-sand/90">
        Partner with CIIHF to put your brand on jerseys, boards, camps, and travel kits — while helping Cayman kids
        compete from Crewe Road to ECHO, TORHS, and NARCh.
      </p>
      <ul class="mt-6 max-w-xl list-disc space-y-2 pl-5 text-sm text-sand/85">
        <li>Youth development from Learn to Skate through 16U</li>
        <li>National / travel team exposure in North American tournaments</li>
        <li>Community visibility at King's Sports Centre year-round</li>
      </ul>

      <div class="mt-10 max-w-xl space-y-4 border border-white/15 bg-white/5 p-6">
        <p class="font-display text-2xl">Become a sponsor</p>
        <p class="text-sm text-sand/80">
          Email us with your organisation name and interest, or use the button below to open a draft message.
        </p>
        <a
          href="mailto:ciinlinehockey@gmail.com?subject=CIIHF%20sponsor%20inquiry"
          class="inline-block rounded bg-red px-5 py-2.5 text-sm font-semibold tracking-wide text-white uppercase hover:bg-red-hot"
        >
          Email sponsor inquiry
        </a>
      </div>
    </div>
  </section>
</Layout>
