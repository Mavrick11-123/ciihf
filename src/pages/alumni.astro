---
import Layout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import alumni from '../content/alumni.json';
---

<Layout
  title="Past Players"
  description="Alumni of Cayman Islands inline hockey, including NHL draft stories from King's Sports Centre."
>
  <PageHero
    eyebrow="Past players"
    title="Alumni of the island rink"
    lead="Public, newsworthy alumni start the list. Additional names go live only with federation approval."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="grid gap-6 lg:grid-cols-2">
      {alumni.filter((a) => a.featured).map((person) => (
        <article class="border border-sand bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold tracking-wide text-red uppercase">{person.era}</p>
          <h2 class="mt-2 font-display text-4xl text-navy">{person.name}</h2>
          <p class="mt-4 text-ink/80">{person.summary}</p>
          {person.links.length > 0 && (
            <ul class="mt-4 space-y-1 text-sm">
              {person.links.map((link) => (
                <li>
                  <a class="font-semibold text-blue hover:text-red" href={link.href} target="_blank" rel="noreferrer">
                    {link.label} →
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    <div class="mt-12">
      <h3 class="font-display text-3xl text-navy">Also from the program</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {alumni.filter((a) => !a.featured).map((person) => (
          <article class="border border-sand bg-mist p-5">
            <h4 class="font-display text-2xl text-navy">{person.name}</h4>
            <p class="mt-1 text-xs font-semibold text-red uppercase">{person.era}</p>
            <p class="mt-3 text-sm text-ink/75">{person.summary}</p>
          </article>
        ))}
      </div>
    </div>

    <aside class="mt-12 max-w-3xl border-l-4 border-red bg-white p-5 text-sm text-ink/70">
      Local coverage has also named players and builders such as Josh Small, Justin Hastings, Kai Robinson-Allard, Ethan
      Finlason, Andrew Hastings, Jabari Waldron, Patrick Cover, Paul Strenk, Evan Ellbogen, Dennis Passchier, and Ray
      Singh. Those names stay off the public alumni grid until CIIHF approves featuring them here.
    </aside>
  </section>
</Layout>
