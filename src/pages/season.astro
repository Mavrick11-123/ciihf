---
import Layout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import site from '../content/site.json';
import ageGroups from '../content/age-groups.json';
---

<Layout
  title={`${site.seasonLabel} Season`}
  description={`Age groups, season structure, and registration notes for the CIIHF ${site.seasonLabel} season.`}
>
  <PageHero
    eyebrow={site.seasonLabel}
    title="Seasons & age groups"
    lead="Structure for the current cycle is ready. Practice nights, fees, and registration steps will be published when CIIHF confirms them — we are not inventing schedules."
  />

  <section id="seasons" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-14 md:px-6">
    <h2 class="text-4xl text-navy">Season</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {[
        {
          title: 'On island',
          body: "Youth leagues, men's Cherry Cup, Sunday drop-in, and camps at King's Sports Centre.",
        },
        {
          title: 'Travel',
          body: 'ECHO, TORHS, and NARCh windows to be confirmed. 16U travel is active for 2026.',
        },
        {
          title: 'Registration',
          body: 'How-to, fees, and cutoffs — to be confirmed. Contact the federation to join in the meantime.',
        },
      ].map((block) => (
        <div class="border border-dashed border-blue/30 bg-white p-5">
          <p class="font-display text-2xl text-navy">{block.title}</p>
          <p class="mt-2 text-sm text-ink/75">{block.body}</p>
          <p class="mt-3 text-xs font-semibold tracking-wide text-red uppercase">Details TBD</p>
        </div>
      ))}
    </div>
  </section>

  <section id="age-groups" class="scroll-mt-24 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
      <h2 class="text-4xl text-navy">Age groups</h2>
      <p class="mt-3 max-w-2xl text-ink/75">
        Labels match current King's / CIIHF public programming (plus the 2026 16U team). Older names like Atoms and
        Mites appear only in our history timeline.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {ageGroups.map((group) => (
          <article class="border border-sand bg-mist p-5">
            <p class="text-xs font-semibold tracking-wide text-red uppercase">{group.ages}</p>
            <h3 class="mt-1 font-display text-3xl text-navy">{group.name}</h3>
            <p class="mt-3 text-sm text-ink/80">{group.summary}</p>
            <p class="mt-4 text-xs text-ink/50">{group.schedule}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 text-sm">
        Questions about which group fits your player?
        <a class="font-semibold text-blue hover:text-red" href="/contact"> Contact CIIHF →</a>
      </p>
    </div>
  </section>
</Layout>
