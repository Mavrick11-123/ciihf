---
import site from '../content/site.json';
---

<footer class="border-t border-white/10 bg-navy-deep text-sand">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3 md:px-6">
    <div>
      <p class="font-display text-3xl text-white">{site.shortName}</p>
      <p class="mt-2 max-w-xs text-sm text-sand/80">{site.mission}</p>
      <p class="mt-4 text-sm font-semibold text-red">{site.tagline}</p>
    </div>
    <div>
      <p class="font-display text-xl text-white">Visit</p>
      <p class="mt-2 text-sm">
        {site.location.venue}<br />
        {site.location.address}
      </p>
      <p class="mt-3 text-xs text-sand/60">{site.location.note}</p>
    </div>
    <div>
      <p class="font-display text-xl text-white">Connect</p>
      <ul class="mt-2 space-y-2 text-sm">
        <li>
          <a class="hover:text-white" href={`mailto:${site.contacts.federationEmail}`}>
            {site.contacts.federationEmail}
          </a>
        </li>
        <li>
          <a class="hover:text-white" href={site.social.instagram} target="_blank" rel="noreferrer">
            Instagram @cayman.hockey
          </a>
        </li>
        <li>
          <a class="hover:text-white" href={site.social.facebook} target="_blank" rel="noreferrer">
            Facebook · Cayman Inline Hockey
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-sand/50">
    © {new Date().getFullYear()} Cayman Islands Inline Hockey Federation Ltd.
  </div>
</footer>
