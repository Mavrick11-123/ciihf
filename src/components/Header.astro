---
import site from '../content/site.json';

const links = [
  { href: '/about', label: 'About' },
  { href: '/season', label: '2026–27' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/photos', label: 'Photos' },
  { href: '/alumni', label: 'Past Players' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-navy/95 text-white backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/logo.png" alt="CIIHF" class="h-11 w-11" width="44" height="44" />
      <span class="leading-tight">
        <span class="font-display block text-2xl tracking-wide text-white">{site.shortName}</span>
        <span class="hidden text-xs text-sand/80 sm:block">Inline Hockey Federation</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded px-3 py-2 text-sm font-medium transition hover:bg-white/10',
            pathname === link.href || pathname.startsWith(link.href + '/')
              ? 'bg-white/15 text-white'
              : 'text-sand/90',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded border border-white/20 px-3 py-2 text-sm">Menu</summary>
      <div class="absolute right-0 mt-2 w-52 rounded-lg border border-white/10 bg-navy-deep p-2 shadow-xl">
        {links.map((link) => (
          <a href={link.href} class="block rounded px-3 py-2 text-sm text-sand hover:bg-white/10">
            {link.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
